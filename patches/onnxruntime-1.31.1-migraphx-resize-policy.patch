+// RedLnx: MIGraphX 7.1 throws on Resize's keep_aspect_ratio_policy, which ORT's
+// graph resolution adds to every opset-18 Resize at its default (graph.cc).
+// "stretch" is the behaviour without the attribute; renamed, MIGraphX's parser
+// ignores it. The bridge cannot remove an attribute or read a NodeProto's op
+// type: GraphViewer::ToProto writes the nodes in this topological order.
+static void HideDefaultResizePolicy(const onnxruntime::GraphViewer& graph_viewer,
+                                    ONNX_NAMESPACE::GraphProto& graph_proto) {
+  const auto& order = graph_viewer.GetNodesInTopologicalOrder();
+  for (size_t i = 0; i < order.size(); ++i) {
+    const auto* node = graph_viewer.GetNode(order[i]);
+    if (node == nullptr || node->OpType() != "Resize") {
+      continue;
+    }
+    auto* node_proto = graph_proto.mutable_node(static_cast<int>(i));
+    for (int a = 0; a < node_proto->attribute_size(); ++a) {
+      auto* attribute = node_proto->mutable_attribute(a);
+      if (attribute->name() == "keep_aspect_ratio_policy" && attribute->s() == "stretch") {
+        attribute->set_name("redlnx_default_keep_aspect_ratio_policy");
+      }
+    }
+  }
+}
